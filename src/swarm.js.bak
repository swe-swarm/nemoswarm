// Swarm system — multi-agent orchestration
// Pattern: coordinator agent delegates tasks to specialized sub-agents via delegate() tool.
// Sub-agents run with their own Session, system prompt, and tool restrictions.
// Results flow back to the coordinator as tool responses, which it synthesizes.
import { readFileSync, existsSync, readdirSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';
import chalk from 'chalk';
import yaml from 'js-yaml';
import { Agent } from './agent.js';
import { Session } from './session.js';

const __dir = dirname(fileURLToPath(import.meta.url));
const BUILTIN_DIR = join(__dir, '..', 'swarms');
const USER_DIR = join(process.env.HOME || '', '.nemo-cli', 'swarms');

// ── SwarmSystem — loads YAML swarm definitions ────────────────────────────────
export class SwarmSystem {
  constructor() {
    this.swarms = new Map();
    this._load(BUILTIN_DIR);
    this._load(USER_DIR);
  }

  _load(dir) {
    if (!existsSync(dir)) return;
    for (const f of readdirSync(dir).filter(f => f.endsWith('.yaml') || f.endsWith('.yml'))) {
      try {
        const d = yaml.load(readFileSync(join(dir, f), 'utf-8'));
        if (d?.name) this.swarms.set(d.name, d);
      } catch {}
    }
  }

  has(name) { return this.swarms.has(name); }
  get(name) { return this.swarms.get(name) || null; }
  list() { return [...this.swarms.values()]; }
}

// ── SwarmRunner — orchestrates a swarm run ────────────────────────────────────
export class SwarmRunner {
  constructor(client, baseConfig, agentSystem, permissions, mcpClient) {
    this.client = client;
    this.baseConfig = baseConfig;
    this.agentSystem = agentSystem;
    this.permissions = permissions;
    this.mcpClient = mcpClient;
  }

  async run(swarmDef, task, ui) {
    // Index sub-agent definitions by role name
    const roles = {};
    for (const a of swarmDef.agents || []) {
      roles[a.role] = a;
    }

    ui.swarmHeader(
      swarmDef.displayName || swarmDef.name,
      swarmDef.description || '',
      Object.keys(roles),
    );

    // ── delegate() tool definition ────────────────────────────────────────────
    // This is the only tool the coordinator uses to spawn sub-agents.
    const delegateTool = {
      type: 'function',
      function: {
        name: 'delegate',
        description: [
          'Spawn a specialized sub-agent to complete a specific task.',
          'The sub-agent has full access to its tools and returns its complete response.',
          'Call delegate() for each specialist needed, then synthesize their results.',
          `Available roles: ${Object.keys(roles).join(', ')}.`,
        ].join(' '),
        parameters: {
          type: 'object',
          properties: {
            role: {
              type: 'string',
              enum: Object.keys(roles),
              description: 'The sub-agent role to assign this task to',
            },
            task: {
              type: 'string',
              description: 'Full, detailed task description for the sub-agent. Be specific.',
            },
          },
          required: ['role', 'task'],
        },
      },
      _swarm: true,
    };

    // ── Sub-agent executor ────────────────────────────────────────────────────
    // Called by the Agent loop when coordinator invokes delegate()
    let delegateIdx = 0;
    const swarmExecutor = async (_toolName, args) => {
      const { role, task: subTask } = args;
      const roleDef = roles[role];
      if (!roleDef) {
        return {
          output: `Unknown role: "${role}". Available: ${Object.keys(roles).join(', ')}`,
          exitCode: 1,
        };
      }

      delegateIdx++;
      ui.subAgentHeader(role, roleDef.displayName || role, delegateIdx, Object.keys(roles).length);

      // Build sub-agent config: start from base, apply named agent if specified
      let subConfig = { ...this.baseConfig };
      if (roleDef.agent && this.agentSystem) {
        const applied = this.agentSystem.applyAgent(roleDef.agent, subConfig);
        if (applied) subConfig = applied;
      }
      // Override system prompt if the role defines one explicitly
      if (roleDef.prompt) {
        subConfig.systemPrompt = roleDef.prompt
          .replace(/\{\{cwd\}\}/g, process.cwd())
          .replace(/\{\{platform\}\}/g, process.platform);
      }

      // Permissions for sub-agent: restrict to declared tools, always auto-approve
      const subPerms = roleDef.tools
        ? new AutoPermissions(new Set(roleDef.tools))
        : new AutoPermissions(null);

      const subSession = new Session(subConfig);
      subSession.addSystem(subConfig.systemPrompt);

      const subUI = new SubAgentUI(ui, role);

      const subAgent = new Agent(this.client, subSession, subUI, subConfig, {
        permissions: subPerms,
        mcpClient: this.mcpClient,
        stream: true,
        silent: false,
      });

      let result;
      try {
        result = await subAgent.run(subTask);
      } catch (err) {
        result = `Sub-agent error: ${err.message}`;
      }

      ui.subAgentFooter(role);
      return { output: result || '(sub-agent returned no output)', exitCode: 0 };
    };

    // ── Coordinator agent ─────────────────────────────────────────────────────
    const coordPrompt = this._buildCoordPrompt(swarmDef, roles);
    const coordConfig = { ...this.baseConfig, systemPrompt: coordPrompt };
    const coordSession = new Session(coordConfig);
    coordSession.addSystem(coordPrompt);

    const coordAgent = new Agent(this.client, coordSession, ui, coordConfig, {
      permissions: this.permissions,
      mcpClient: this.mcpClient,
      stream: true,
      silent: false,
      swarmExecutor,
    });

    // Inject the delegate tool alongside the coordinator's standard tools
    const origGetTools = coordAgent.getToolDefinitions.bind(coordAgent);
    coordAgent.getToolDefinitions = () => [delegateTool, ...origGetTools()];

    return coordAgent.run(task);
  }

  _buildCoordPrompt(swarmDef, roles) {
    const roleList = Object.entries(roles)
      .map(([role, def]) => `  - ${role}: ${def.description || role}`)
      .join('\n');

    const base = swarmDef.coordinator_prompt || `\
You are a swarm coordinator. Orchestrate specialized sub-agents to complete the task.

Process:
1. Analyze the task and decide which sub-agents are needed
2. Call delegate() for each relevant sub-agent with a precise, detailed task
3. After all delegations complete, synthesize a concise final response

Delegate work to specialists — do not do their jobs yourself.`;

    return `${base}

Working directory: ${process.cwd()}
Platform: ${process.platform}

Available sub-agents:
${roleList}

Use delegate() to spawn sub-agents. Each call blocks until the sub-agent completes and returns its full response.`;
  }
}

// ── AutoPermissions — always allows, filters by tool list ─────────────────────
// Sub-agents run without interactive prompts.
class AutoPermissions {
  constructor(allowedTools) {
    this.availableTools = allowedTools; // Set or null (null = all)
  }
  isExcluded(name) { return this.availableTools ? !this.availableTools.has(name) : false; }
  isDenied() { return false; }
  isAllowed() { return true; }
  async checkPermission() { return { allowed: true }; }
  filterTools(tools) {
    if (!this.availableTools) return tools;
    return tools.filter(t => {
      const n = t.function?.name || t.name;
      return this.availableTools.has(n);
    });
  }
}

// ── SubAgentUI — proxied UI for sub-agents ────────────────────────────────────
// Shows tool calls with indentation. Hides spinner/thinking (too noisy).
// Streams response text dimmed to distinguish from coordinator output.
class SubAgentUI {
  constructor(mainUI, role) {
    this.mainUI = mainUI;
    this.role = role;
    this._col = 0;
  }

  // Suppress spinner and thinking for sub-agents
  startSpinner() {}
  stopSpinner() {}
  startThinking() {}
  streamThinkToken() {}
  stopThinking() {}

  // Stream response inline, dimmed
  streamToken(token) {
    process.stdout.write(chalk.white(token));
  }

  toolStart(name, args) {
    const a = typeof args === 'string' ? args : JSON.stringify(args);
    const preview = a.length > 100 ? a.slice(0, 100) + '…' : a;
    console.log(chalk.dim(`    ⚡ ${chalk.yellow(name)} ${preview}`));
  }

  toolResult(name, result) {
    if (result.error) {
      console.log(chalk.dim(`    ${chalk.red('✗')} ${name}: ${result.error.slice(0, 150)}`));
    } else {
      const lines = (result.output || '').split('\n').length;
      console.log(chalk.dim(`    ${chalk.green('✓')} ${name} (${lines} lines)`));
    }
  }

  printError(msg) { console.log(chalk.red(`    ✗ [${this.role}] ${msg}`)); }
  printInfo() {}
  printWarning(msg) { console.log(chalk.yellow(`    ⚠ [${this.role}] ${msg}`)); }
}
