# Example Docker --env-file for the APIM self-hosted gateway on Anton.
# Copy to /opt/apim-gateway/anton.env on Anton, insert the real gateway
# registration token there, then protect it with chmod 600.
#
# Do NOT commit real copied env files, registration tokens, or generated secrets.

config.service.endpoint=https://darbotlabs.configuration.azure-api.net
config.service.auth=GatewayKey <gateway-registration-token>
